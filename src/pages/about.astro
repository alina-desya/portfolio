---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
// Page text lives in the MDX file
import Bio, { frontmatter as page } from '../content/pages/about.mdx';
---

<Base title="About" description={page.description}>
  <div class="container">
    <header class="page-head about-head">
      <div>
        <span class="eyebrow">{page.eyebrow}</span>
        <h1>{page.headline}</h1>
        <div class="actions">
          <a class="btn btn-primary" href={site.cv} download>Download CV (PDF)</a>
          <a class="btn btn-secondary" href="/contact/">Get in touch</a>
        </div>
      </div>
      <img src={site.photo} alt={`Portrait of ${site.name}`} width="260" height="300" />
    </header>

    <section class="section prose">
      <p class="lead">{page.lead}</p>
      <Bio />
    </section>

    <section class="section two-col">
      <div>
        <h2>Selected Experience</h2>
        <ol class="timeline">
          {page.experience.map((e) => (
            <li>
              <span class="muted period">{e.period}</span>
              <h3>{e.role} <span class="muted">· {e.url ? <a href={e.url}>{e.org}</a> : e.org}</span></h3>
              <p class="muted">{e.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2>Skills</h2>
        <ul class="tags skills">{page.skills.map((s) => <li class="tag">{s}</li>)}</ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .about-head { display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
  .about-head img { border-radius: 24px; width: 260px; aspect-ratio: 13 / 15; object-fit: cover; background: var(--surface-2); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .two-col { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; border-top: 1px solid var(--border); }
  .timeline { list-style: none; padding: 0; margin: 0; }
  .timeline li { padding: 16px 0 16px 20px; border-left: 2px solid var(--border); position: relative; }
  .timeline li::before {
    content: ''; position: absolute; left: -6px; top: 24px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent);
  }
  .period { font-size: 0.88rem; }
  .timeline h3 { margin: 2px 0 4px; font-size: 1.15rem; }
  .skills .tag { font-size: 0.88rem; padding: 6px 12px; }
  @media (max-width: 820px) {
    .about-head, .two-col { grid-template-columns: 1fr; gap: 32px; }
    .about-head img { width: 200px; order: -1; }
  }
</style>
