---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

// TODO: replace with your real experience
const experience = [
  { period: '20XX – now', role: 'Senior Technical Writer', org: 'Company name', text: 'One line on scope and impact.' },
  { period: '20XX – 20XX', role: 'Technical Writer', org: 'Company name', text: 'One line on scope and impact.' },
];

const skills = [
  'API documentation (OpenAPI)', 'Docs-as-code', 'Information architecture', 'Knowledge management',
  'Content strategy', 'Taxonomy & metadata', 'AI-assisted documentation', 'Developer experience',
];
---

<Base title="About" description={`About ${site.name}, ${site.role}.`}>
  <div class="container">
    <header class="page-head about-head">
      <div>
        <span class="eyebrow">About</span>
        <h1>Writer, architect, translator between people and systems.</h1>
        <div class="actions">
          <a class="btn btn-primary" href={site.cv} download>Download CV (PDF)</a>
          <a class="btn btn-secondary" href="/contact/">Get in touch</a>
        </div>
      </div>
      <img src={site.photo} alt={`Portrait of ${site.name}`} width="260" height="300" />
    </header>

    <section class="section prose">
      <!-- TODO: your bio. 2–4 short paragraphs: what you do, how you think, what you're known for. -->
      <p class="lead">
        I'm a Senior Technical Writer and Knowledge Architect. I design documentation and knowledge systems that help
        people — and increasingly AI — find the right answer the first time.
      </p>
      <p>
        Placeholder bio: add a paragraph about your background, the kinds of products and teams you've worked with, and
        what you care about most in your work.
      </p>
      <p>
        Placeholder: a short personal note — what you do outside work, where you're based, what you're exploring now.
      </p>
    </section>

    <section class="section two-col">
      <div>
        <h2>Experience</h2>
        <ol class="timeline">
          {experience.map((e) => (
            <li>
              <span class="muted period">{e.period}</span>
              <h3>{e.role} <span class="muted">· {e.org}</span></h3>
              <p class="muted">{e.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2>Skills</h2>
        <ul class="tags skills">{skills.map((s) => <li class="tag">{s}</li>)}</ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .about-head { display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
  .about-head img { border-radius: 24px; width: 260px; aspect-ratio: 13 / 15; object-fit: cover; background: var(--surface-2); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  .two-col { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; border-top: 1px solid var(--border); }
  .timeline { list-style: none; padding: 0; margin: 0; }
  .timeline li { padding: 16px 0 16px 20px; border-left: 2px solid var(--border); position: relative; }
  .timeline li::before {
    content: ''; position: absolute; left: -6px; top: 24px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent);
  }
  .period { font-size: 0.88rem; }
  .timeline h3 { margin: 2px 0 4px; font-size: 1.15rem; }
  .skills .tag { font-size: 0.88rem; padding: 6px 12px; }
  @media (max-width: 820px) {
    .about-head, .two-col { grid-template-columns: 1fr; gap: 32px; }
    .about-head img { width: 200px; order: -1; }
  }
</style>
