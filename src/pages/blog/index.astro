---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
// Page text and the featured posts list live in the MDX file
import { frontmatter as page } from '../../content/pages/blog.mdx';

const ext = { target: '_blank', rel: 'noopener' };
---

<Base title="Blog" description={page.description}>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.headline}</h1>
      <p class="lead">{page.lead}</p>
      <a class="btn btn-secondary" href={site.links.linkedin} {...ext}>{page.followLabel} ↗</a>
    </header>

    <section class="newsletter">
      <div>
        <span class="eyebrow">Newsletter</span>
        <h2>{page.newsletter.name}</h2>
        <p class="audience">{page.newsletter.audience}</p>
        <p class="muted">{page.newsletter.text}</p>
      </div>
      <a class="btn btn-primary" href={site.links.newsletter} {...ext}>Subscribe on LinkedIn ↗</a>
    </section>

    {page.posts?.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Featured posts</h2>
          <a href={site.links.linkedin} {...ext}>All posts on LinkedIn ↗</a>
        </div>
        <div class="grid">
          {page.posts.map((p) => (
            <a class="card" href={p.url} {...ext}>
              <div class="meta">
                {p.type && <span class="tag">{p.type}</span>}
                {p.date && <span class="muted">{p.date}</span>}
              </div>
              <h3>{p.title}</h3>
              {p.summary && <p>{p.summary}</p>}
              <span class="more">Read on LinkedIn ↗</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .page-head .lead { margin-bottom: 24px; }
  .newsletter {
    display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap;
    margin-top: 24px; padding: 40px;
    border-radius: 24px;
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .newsletter > div { max-width: 60ch; }
  .newsletter h2 { margin-bottom: 4px; }
  .newsletter .audience { font-weight: 600; margin-bottom: 8px; }
  .newsletter p:last-child { margin: 0; }
  .meta { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-size: 0.88rem; }
  @media (max-width: 640px) { .newsletter { padding: 28px 20px; } }
</style>
