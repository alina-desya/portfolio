---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
// Page text lives in the MDX file
import { frontmatter as page } from '../../content/pages/blog.mdx';
import NewsletterCTA from '../../components/NewsletterCTA.astro';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Blog" description={page.description}>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.headline}</h1>
      <p class="lead">{page.lead}</p>
    </header>

    <section class="section list">
      {posts.map((p) => (
        <a class="post" href={`/blog/${p.id}/`}>
          <time datetime={p.data.date.toISOString()}>
            {p.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
          <div>
            <h2>{p.data.title}</h2>
            <p class="muted">{p.data.description}</p>
          </div>
        </a>
      ))}
    </section>

    <NewsletterCTA />
  </div>
</Base>

<style>
  .list { padding-top: 24px; }
  .post {
    display: grid; grid-template-columns: 140px 1fr; gap: 24px;
    padding: 24px 0; border-top: 1px solid var(--border);
    color: inherit; text-decoration: none;
  }
  .post:hover h2 { color: var(--accent); }
  time { color: var(--muted); font-size: 0.9rem; padding-top: 6px; }
  h2 { font-size: 1.4rem; margin-bottom: 6px; transition: color 0.15s; }
  p { margin: 0; }
  @media (max-width: 640px) { .post { grid-template-columns: 1fr; gap: 4px; } }
</style>
