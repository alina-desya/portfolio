---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---

<!-- If the post was first published on LinkedIn, point search engines at the original -->
<Base title={d.title} description={d.description} canonical={d.originalUrl}>
  <article class="container">
    <header class="page-head">
      <a href="/blog/" class="back">← Blog</a>
      <h1>{d.title}</h1>
      <p class="muted">
        <time datetime={d.date.toISOString()}>
          {d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
        {d.originalUrl && <> · Originally published on <a href={d.originalUrl}>LinkedIn</a></>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <div class="section"><NewsletterCTA /></div>
  </article>
</Base>

<style>
  .back { display: block; width: fit-content; margin-bottom: 20px; text-decoration: none; font-weight: 500; }
  h1 { max-width: 22ch; }
</style>
