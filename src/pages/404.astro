---
import Base from '../layouts/Base.astro';
import { site, nav } from '../site.config';
// Page text lives in the MDX file
import { frontmatter as page } from '../content/pages/not-found.mdx';

const pages = [{ href: '/', label: 'Home' }, ...nav, { href: '/contact/', label: 'Contact' }];
const reportMail = `mailto:${site.email}?subject=${encodeURIComponent('Broken link on your site')}`;
---

<Base title={page.title} description={page.description} noindex>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.headline}</h1>
      <p class="lead">{page.lead}</p>
      {page.newsletterHint && (
        <aside class="hint">
          <p><strong>{page.newsletterHint.lead}</strong> {page.newsletterHint.text}</p>
          <a class="btn btn-primary" href={site.links.newsletter} target="_blank" rel="noopener">{page.newsletterHint.linkLabel} ↗</a>
        </aside>
      )}
      <p class="path"><span class="muted">Requested:</span> <code id="requested-path">this page</code></p>
    </header>

    <section class="section troubleshoot">
      <table>
        <thead>
          <tr><th>Error code</th><th>Solution</th></tr>
        </thead>
        <tbody>
          {page.errors.map((e) => (
            <tr>
              <td><code>{e.code}</code></td>
              <td>
                {e.solution}
                {e.action === 'report' && <> <a id="report-link" href={reportMail}>Report it →</a></>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="section">
      <h2>{page.pagesTitle}</h2>
      <ul class="pages">
        {pages.map((p) => (
          <li><a href={p.href}>{p.label}<span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  // Show the address the visitor tried, and include it in the "Report it" email
  const path = decodeURIComponent(location.pathname);
  const el = document.getElementById('requested-path');
  if (el) el.textContent = path;
  const report = document.getElementById('report-link') as HTMLAnchorElement | null;
  if (report) {
    const from = document.referrer ? `\nLinked from: ${document.referrer}` : '';
    report.href += `&body=${encodeURIComponent(`Broken address: ${location.href}${from}\n`)}`;
  }
</script>

<style>
  .path { margin: 0; font-size: 0.95rem; }
  .path code {
    background: var(--surface-2); padding: 4px 10px; border-radius: 6px;
    font-size: 0.9em; word-break: break-all;
  }

  .troubleshoot { padding-top: 32px; }
  table {
    width: 100%; max-width: 860px; border-collapse: collapse;
    background: var(--surface); font-size: 0.95rem; line-height: 1.5;
  }
  th, td { padding: 14px 16px; border: 1px solid var(--border); text-align: left; vertical-align: top; }
  th { background: var(--surface-2); font-weight: 600; }
  td:first-child { width: 1%; white-space: nowrap; }
  td code { background: var(--accent-soft); color: var(--accent); padding: 2px 8px; border-radius: 6px; font-size: 0.85em; }
  td a { font-weight: 600; text-decoration: none; white-space: nowrap; }

  .pages { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .pages a {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 18px; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); color: var(--text); text-decoration: none; font-weight: 500;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .pages a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .pages a span { color: var(--accent); }

  /* Newsletter hint, highlighted in green */
  .hint {
    display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap;
    max-width: 860px; margin: 4px 0 24px; padding: 18px 22px;
    background: var(--accent-soft); border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .hint p { margin: 0; flex: 1 1 360px; }
  .hint .btn { padding: 10px 20px; white-space: nowrap; }

  @media (max-width: 640px) {
    td:first-child { white-space: normal; }
    th, td { padding: 10px 12px; }
  }
</style>
