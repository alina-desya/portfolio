---
import Base from '../layouts/Base.astro';
---

<Base title="MexiDocs" description="MexiDocs — stickers for people who write the docs.">
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">MexiDocs</span>
      <h1>Stickers for people who write the docs.</h1>
      <p class="lead">Coming soon. <!-- TODO: story behind MexiDocs, sticker gallery, how to get them --></p>
    </header>
    <div class="soon">
      <span>🌮</span><span>📚</span><span>🌵</span>
    </div>
  </div>
</Base>

<style>
  .soon {
    display: flex; justify-content: center; gap: 24px; font-size: 3rem;
    padding: 64px 0; margin: 24px 0 40px;
    border: 2px dashed var(--border); border-radius: 24px;
  }
</style>
