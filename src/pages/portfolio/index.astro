---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
// Page text lives in the MDX file
import { frontmatter as page } from '../../content/pages/portfolio.mdx';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const samples = (await getCollection('samples')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Portfolio" description={page.description}>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.headline}</h1>
      <p class="lead">{page.lead}</p>
    </header>

    <section class="section">
      <h2>Projects</h2>
      <div class="grid">
        {projects.map((p) => (
          <a class="card" href={`/portfolio/${p.id}/`}>
            <ul class="tags">{p.data.tags.map((t) => <li class="tag">{t}</li>)}</ul>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <span class="more">View project →</span>
          </a>
        ))}
      </div>
    </section>

    {samples.length > 0 && (
      <section class="section">
        <h2>Writing samples</h2>
        <div class="grid">
          {samples.map((s) => (
            <a class="card" href={s.data.url ?? `/portfolio/samples/${s.id}/`}>
              <ul class="tags"><li class="tag">{s.data.kind}</li></ul>
              <h3>{s.data.title}</h3>
              <p>{s.data.summary}</p>
              <span class="more">{s.data.url ? 'View sample ↗' : 'Read sample →'}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
