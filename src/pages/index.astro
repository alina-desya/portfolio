---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TalkItem from '../components/TalkItem.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import { site } from '../site.config';
// Page text lives in the MDX file
import { frontmatter as page } from '../content/pages/home.mdx';

const projects = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const talks = (await getCollection('talks')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">{site.role}</span>
        <h1>{page.headline} <em>{page.highlight}</em></h1>
        <p class="lead">{site.tagline}</p>
        <div class="actions">
          <a class="btn btn-primary" href="/contact/">Get in touch →</a>
          <a class="btn btn-secondary" href="/portfolio/">See my work</a>
        </div>
      </div>
      <div class="photo-wrap">
        <img src={site.photo} alt={`Portrait of ${site.name}`} width="440" height="520" />
      </div>
    </div>
  </section>

  <section class="section pillars">
    <div class="container grid">
      {page.pillars.map((p, i) => (
        <div class="pillar">
          <span class="num">0{i + 1}</span>
          <h3>{p.title}</h3>
          <p class="muted">{p.text}</p>
        </div>
      ))}
    </div>
    <div class="container pillars-more">
      <a href="/services/">How I can help your team →</a>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Selected work</h2>
          <a href="/portfolio/">All projects & writing samples →</a>
        </div>
        <div class="grid">
          {projects.map((p) => (
            <a class="card" href={`/portfolio/${p.id}/`}>
              <ul class="tags">{p.data.tags.map((t) => <li class="tag">{t}</li>)}</ul>
              <h3>{p.data.title}</h3>
              <p>{p.data.summary}</p>
              <span class="more">Read case study →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {talks.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Recent talks</h2>
          <a href="/speaking/">All talks & videos →</a>
        </div>
        {talks.map((t) => <TalkItem talk={t} />)}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      {posts.length > 0 && (
        <>
          <div class="section-head">
            <h2>Latest writing</h2>
            <a href="/blog/">All posts →</a>
          </div>
          <div class="grid" style="margin-bottom: 40px">
            {posts.map((p) => (
              <a class="card" href={`/blog/${p.id}/`}>
                <time class="muted" datetime={p.data.date.toISOString()}>
                  {p.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
                <span class="more">Read →</span>
              </a>
            ))}
          </div>
        </>
      )}
      <NewsletterCTA />
    </div>
  </section>

  <section class="section">
    <div class="container contact-band">
      <h2>{page.contactTitle}</h2>
      <p class="lead">{page.contactText}</p>
      <div class="actions">
        <a class="btn btn-primary" href="/contact/">Get in touch →</a>
        <a class="btn btn-secondary" href={site.cv}>Download CV</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 72px 0 32px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: center; }
  h1 em { font-style: italic; color: var(--accent); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .photo-wrap { position: relative; justify-self: center; max-width: 400px; width: 100%; }
  .photo-wrap::before {
    content: ''; position: absolute; inset: 18px -18px -18px 18px;
    border-radius: 28px; background: var(--warm); opacity: 0.85; z-index: 0;
  }
  .photo-wrap img { position: relative; z-index: 1; border-radius: 28px; aspect-ratio: 11 / 13; object-fit: cover; width: 100%; background: var(--surface-2); }

  .pillars { padding-top: 40px; }
  .pillar { padding: 8px 4px; border-top: 2px solid var(--text); padding-top: 20px; }
  .pillars-more { margin-top: 20px; font-weight: 600; }
  .num { font-family: var(--font-display); color: var(--warm); font-weight: 600; font-size: 1.1rem; }

  .contact-band {
    text-align: center; padding: 56px 24px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 24px; box-shadow: var(--shadow);
  }
  .contact-band .lead { margin: 0 auto; }
  .contact-band .actions { justify-content: center; }

  @media (max-width: 820px) {
    .hero { padding-top: 40px; }
    .hero-grid { grid-template-columns: 1fr; gap: 48px; }
    .photo-wrap { max-width: 280px; justify-self: start; }
  }
  @media (max-width: 640px) {
    .contact-band { width: auto; margin: 0 16px; padding: 40px 20px; }
  }
</style>
