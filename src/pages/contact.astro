---
import Base from '../layouts/Base.astro';
// Page text lives in the MDX file
import Intro, { frontmatter as page } from '../content/pages/contact.mdx';
---

<Base title="Contact" description={page.description}>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.headline}</h1>
      <div class="lead"><Intro /></div>
    </header>
  </div>
</Base>
