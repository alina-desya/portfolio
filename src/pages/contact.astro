---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
// Page text lives in the MDX file
import { frontmatter as page } from '../content/pages/contact.mdx';

const c = page.card;
---

<Base title="Contact" description={page.description}>
  <div class="container">
    <div class="page-head contact">
      <div class="intro">
        <span class="eyebrow">{page.eyebrow}</span>
        <h1>{page.headline}</h1>
        <p class="lead">{page.lead}</p>
        <p class="location">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" /><circle cx="12" cy="10" r="2.5" /></svg>
          <span>{page.location}</span>
        </p>
      </div>

      <aside class="card contact-card" aria-label="Contact details">
        <ul class="links">
          <li>
            <a href={`mailto:${site.email}${c.emailSubject ? `?subject=${encodeURIComponent(c.emailSubject)}` : ''}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
              <span>{site.email}</span>
            </a>
          </li>
          <li>
            <a href={site.links.linkedin} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></svg>
              <span>{c.linkedinLabel}</span>
            </a>
          </li>
          <li>
            <a href={site.cv} download>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" /></svg>
              <span>{c.cvLabel}</span>
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</Base>

<style>
  .contact {
    display: grid; grid-template-columns: 1fr minmax(320px, 420px); gap: 56px; align-items: start;
    padding-bottom: 80px;
  }
  .lead { margin-bottom: 20px; }
  .location { display: flex; align-items: flex-start; gap: 12px; margin: 0; color: var(--muted); }

  svg {
    width: 20px; height: 20px; flex-shrink: 0;
    fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
  }
  .location svg { margin-top: 3px; }

  /* Contact card: three rows with the same icon column and text alignment */
  /* Starts level with the lead paragraph, just below the "Let's talk." title */
  .contact-card { padding: 8px 28px; margin-top: 128px; }
  .links { list-style: none; padding: 0; margin: 0; }
  .links li + li { border-top: 1px solid var(--border); }
  .links a {
    display: flex; align-items: center; gap: 14px; padding: 18px 0;
    color: var(--text); text-decoration: none; font-weight: 500; word-break: break-word;
  }
  .links a:hover { color: var(--accent); }

  @media (max-width: 820px) {
    .contact { grid-template-columns: 1fr; gap: 32px; padding-bottom: 48px; }
    .contact-card { margin-top: 0; }
  }
  @media (max-width: 640px) {
    .contact-card { padding: 4px 18px; }
  }
</style>
