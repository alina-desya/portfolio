---
import Base from '../../layouts/Base.astro';
import TalkItem from '../../components/TalkItem.astro';
import { site } from '../../site.config';
// Page text and all talks live in the MDX file
import { frontmatter as page } from '../../content/pages/speaking.mdx';
---

<Base title="Speaking & Media" description={page.description}>
  <div class="container">
    <header class:list={["page-head", { head: site.showSpeakerKit }]}>
      <div>
        <span class="eyebrow">{page.eyebrow}</span>
        <h1>{page.headline}</h1>
        <p class="lead">{page.lead}</p>
      </div>
      {site.showSpeakerKit && (
        <div class="kit-box">
          <strong>{page.kitTitle}</strong>
          <p class="muted">{page.kitText}</p>
          <a class="btn btn-primary" href="/speaking/kit/">Speaker kit →</a>
        </div>
      )}
    </header>

    {page.sections.map((s) => (
      <section class="section">
        <h2>{s.title}</h2>
        {s.talks.map((t) => <TalkItem talk={t} embed />)}
      </section>
    ))}
  </div>
</Base>

<style>
  .head { display: grid; grid-template-columns: 1fr 320px; gap: 40px; align-items: end; }
  .kit-box { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); }
  .kit-box p { margin: 6px 0 16px; font-size: 0.95rem; }
  @media (max-width: 820px) { .head { grid-template-columns: 1fr; } }
</style>
