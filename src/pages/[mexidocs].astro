---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
// Page text lives in the MDX file
import Intro, { frontmatter as page } from '../content/pages/mexidocs.mdx';

// Only build this page when MexiDocs is enabled in site.config
export function getStaticPaths() {
  return site.showMexiDocs ? [{ params: { mexidocs: 'mexidocs' } }] : [];
}
---

<Base title="MexiDocs" description={page.description}>
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.headline}</h1>
      <div class="lead"><Intro /></div>
    </header>
    <div class="soon">
      <span>🌮</span><span>📚</span><span>🌵</span>
    </div>
  </div>
</Base>

<style>
  .soon {
    display: flex; justify-content: center; gap: 24px; font-size: 3rem;
    padding: 64px 0; margin: 24px 0 40px;
    border: 2px dashed var(--border); border-radius: 24px;
  }
</style>
