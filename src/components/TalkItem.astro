---
// Talks are listed in src/content/pages/speaking.mdx
export interface Talk {
  title: string;
  event: string;
  date?: string | number;
  location?: string;
  host?: string;
  description?: string;
  video?: string; // YouTube links are embedded automatically
  links?: { label: string; url: string }[];
}

interface Props { talk: Talk; embed?: boolean }
const { talk: t, embed = false } = Astro.props;

// Turn a YouTube link into an embeddable URL
function youtubeId(url?: string) {
  if (!url) return null;
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|live\/|shorts\/))([\w-]{11})/);
  return m ? m[1] : null;
}
const ytId = embed ? youtubeId(t.video) : null;
---

<article class="talk">
  <div class="meta">
    {t.date && <span>{t.date}</span>}
  </div>
  <div class="body">
    <h3>{t.title}</h3>
    <p class="event">
      <strong>{t.event}</strong>
      {t.location && <span> · {t.location}</span>}
      {t.host && <span> · Hosted by {t.host}</span>}
    </p>
    {t.description && <p class="desc">{t.description}</p>}
    {ytId && (
      <div class="video">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${ytId}`}
          title={t.title}
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}
    <div class="links">
      {t.video && !ytId && <a href={t.video}>▶ Watch recording</a>}
      {t.links?.map((l) => <a href={l.url}>{l.label} →</a>)}
    </div>
  </div>
</article>

<style>
  .talk { display: grid; grid-template-columns: 130px 1fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--border); }
  .meta { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; font-size: 0.88rem; color: var(--muted); }
  h3 { margin-bottom: 4px; }
  .event { color: var(--muted); margin-bottom: 8px; }
  .event strong { color: var(--text); font-weight: 600; }
  .desc { margin-bottom: 8px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 16px; font-weight: 600; font-size: 0.95rem; }
  .links a { text-decoration: none; }
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; margin: 12px 0; max-width: 640px; background: var(--surface-2); }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  @media (max-width: 640px) {
    .talk { grid-template-columns: 1fr; gap: 8px; }
    .meta { flex-direction: row; gap: 12px; }
    .meta:empty { display: none; }
  }
</style>
